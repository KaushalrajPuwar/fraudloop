// Scheduled drift check.
//
// Compares the live feature distribution against the training baseline. If it
// has moved far enough, the main pipeline is triggered to retrain and
// redeploy - no human in the loop.

pipeline {
    agent any

    triggers {
        cron('H/30 * * * *')
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
    }

    environment {
        CI_IMAGE  = 'fraudloop-ci:latest'
        NAMESPACE = 'fraudloop'
    }

    stages {
        stage('Collect live stats') {
            steps {
                sh '''
                    kubectl -n "$NAMESPACE" port-forward svc/scorer 18080:80 >/dev/null 2>&1 &
                    PF=$!
                    trap "kill $PF 2>/dev/null || true" EXIT
                    sleep 5
                    curl -fsS http://127.0.0.1:18080/stats -o stats.json
                '''
            }
        }

        stage('Compare to baseline') {
            steps {
                script {
                    def rc = sh(
                        returnStatus: true,
                        script: 'docker run --rm -v "$PWD":/src -w /src $CI_IMAGE python ml/drift_check.py --stats-file stats.json'
                    )

                    if (rc == 2) {
                        echo 'Drift detected - triggering a retrain'
                        build job: 'fraudloop', wait: false
                    } else if (rc != 0) {
                        error "Drift check failed with exit code ${rc}"
                    }
                }
            }
        }
    }
}
